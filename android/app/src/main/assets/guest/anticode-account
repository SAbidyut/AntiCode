#!/bin/bash
# AntiCode: the folder an agent's extra account keeps its sign-in in.
#   anticode-account agy|claude|codex|opencode   prints it (made the first time); nothing for
#                                                the usual account
#   anticode-account codex-config DIR   Codex's settings in DIR get "no sandbox" unless they
#                                       say otherwise (its sandbox needs Linux namespaces,
#                                       which Android doesn't allow: every command would fail)
# Which account a tab uses is the app's choice when it opens the tab (ANTICODE_PROFILE).
#   Claude Code: its config folder (CLAUDE_CONFIG_DIR).
#   Antigravity: keeps its settings in ~/.gemini and its sign-in in the config folder
#   (~/.config, or $XDG_CONFIG_HOME), so the account gets a home of its own: ~/.gemini its own,
#   ~/.config ~/.local ~/.cache folders of its own whose other contents are links to the real
#   home's, like everything else there (git, ssh, the phone's storage, the programs).
kind=$1
if [ "$kind" = codex-config ]; then
  cfg="${2:-$HOME/.codex}/config.toml"
  add=()
  grep -qs '^[[:space:]]*sandbox_mode' "$cfg" || add+=('sandbox_mode = "danger-full-access"')
  # (with full access nothing needs Codex's permission any more: without this it would run
  # any command without asking — this way it asks first, except for plain reading)
  grep -qs '^[[:space:]]*approval_policy' "$cfg" || add+=('approval_policy = "untrusted"')
  [ ${#add[@]} -eq 0 ] && exit 0
  mkdir -p "${cfg%/*}" || exit 0
  # (first in the file: a setting after a [section] would belong to that section)
  { printf '%s\n' "# AntiCode: Codex's sandbox can't work on Android (no Linux namespaces) — commands" \
      "# run without it, and Codex asks before running them (change it with /permissions)." \
      "${add[@]}" ''
    cat "$cfg" 2>/dev/null || true; } > "$cfg.new" && mv "$cfg.new" "$cfg"
  exit 0
fi
name=${ANTICODE_PROFILE-}
[[ $kind == agy || $kind == claude || $kind == codex || $kind == opencode ]] || exit 0
[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,19}$ ]] || exit 0
base=${ANTICODE_REAL_HOME:-$HOME}
d="$base/.anticode/profiles/$kind/$name"
[ -d "$d" ] || mkdir -p "$d" || exit 1
if [ "$kind" = agy ]; then
  shopt -s nullglob dotglob
  # what holds a Google / Antigravity sign-in or its settings: never shared between accounts
  # (whole names: ~/.git-credentials is shared, git over https keeps working)
  own() { [[ ${1,,} =~ ^\.?(antigravity|gemini|jetski|google|gcloud|keyrings?|codeium|windsurf|credentials(\.json)?)$ ]]; }
  # [$2] mirrors [$1]: a link per entry, except the account's own; the folders named after it
  # are folders of the account's own, mirrored the same way (one level down at most)
  mirror() {
    local src=$1 dst=$2 deep=$3 f n
    for f in "$src"/*; do
      n=${f##*/}
      [ "$n" = .anticode ] && continue
      own "$n" && continue
      # (a dotfiles setup's ~/.config may be a link: mirrored all the same)
      if [ -n "$deep" ] && [[ " $deep " == *" $n "* ]] && [ -d "$f" ]; then
        # (made by an earlier version as a link to the real one: a folder of its own now)
        [ -L "$dst/$n" ] && rm -f "$dst/$n"
        mkdir -p "$dst/$n" && mirror "$f" "$dst/$n" ""
        continue
      fi
      [ -e "$dst/$n" ] || [ -L "$dst/$n" ] || ln -s "$f" "$dst/$n"
    done
  }
  for top in .config .local .cache; do
    [ -L "$d/$top" ] && rm -f "$d/$top"
    [ -d "$d/$top" ] || mkdir -p "$d/$top"
  done
  mirror "$base" "$d" ".config .local .cache"
  # (inside ~/.local: share and state hold app data — mirrored, not linked whole)
  for sub in share state; do
    if [ -d "$base/.local/$sub" ]; then
      [ -L "$d/.local/$sub" ] && rm -f "$d/.local/$sub"
      mkdir -p "$d/.local/$sub" && mirror "$base/.local/$sub" "$d/.local/$sub" ""
    fi
  done
fi
printf '%s\n' "$d"
