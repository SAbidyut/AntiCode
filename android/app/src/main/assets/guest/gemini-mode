#!/bin/bash
# AntiCode: should the Claude Code button (and `claude` in a shell) use Gemini models?
#   gemini-mode on       yes — Claude Code is answered by Gemini (needs a key: gemini-key set)
#   gemini-mode off      no — Claude Code as usual, with your Claude account
#   gemini-mode          say which it is
# `claude-gemini` starts Claude Code on Gemini whatever this says. (The same switch as
# openrouter-mode: one at a time.)
G='\033[1;32m'; Y='\033[1;33m'; N='\033[0m'
dir="$HOME/.config/agy-terminal"
flag="$dir/claude-provider"
now=; [ -r "$flag" ] && read -r now < "$flag"
[ -f "$dir/claude-gemini" ] && now=gemini   # (set by an earlier version)
case ${1:-status} in
  on)
    mkdir -p "$dir" && rm -f "$dir/claude-gemini" && printf 'gemini\n' > "$flag"
    echo -e "${G}✓ Claude Code now uses Gemini models${N} (new Claude Code tabs, and \`claude\` in a shell)."
    grep -qs '[^[:space:]]' "$dir/gemini-api-key" || echo -e "${Y}  It still needs a key: run  gemini-key set${N}" ;;
  off)
    rm -f "$dir/claude-gemini"
    [ "$now" = gemini ] && rm -f "$flag"
    echo -e "${G}✓ Claude Code no longer uses Gemini.${N}"
    [ "$now" = openrouter ] && echo "  (It is set to OpenRouter models: openrouter-mode off turns that off.)" ;;
  status|"")
    case $now in
      gemini) echo "Claude Code: Gemini models (gemini-mode off to go back)" ;;
      openrouter) echo "Claude Code: OpenRouter models (gemini-mode on for Gemini instead)" ;;
      *) echo "Claude Code: your Claude account (gemini-mode on for Gemini models)" ;;
    esac ;;
  *) echo "Usage: gemini-mode [on|off]"; exit 2 ;;
esac
