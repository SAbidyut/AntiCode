#!/bin/bash
# AntiCode — install Cursor CLI (run again any time with: cursor-setup)
#   cursor-setup --auto   skip the apt step when the basic tools are already there
set -o pipefail
G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; N='\033[0m'
/usr/local/bin/term-setup "$1" || exit 1
export PATH="$HOME/.local/bin:$PATH"
cursor_ok() {
  { command -v cursor-agent >/dev/null 2>&1 && cursor-agent --version >/dev/null 2>&1; } ||
    { command -v agent >/dev/null 2>&1 && agent --version >/dev/null 2>&1; }
}
if ! cursor_ok; then
  echo -e "\n${G}▸ Installing Cursor CLI (Cursor's official installer)${N}"
  echo -e "${Y}  Downloading the Linux agent bundle into ~/.local/bin…${N}"
  curl -fsSL https://cursor.com/install | bash \
    || { echo -e "${R}Installing Cursor CLI failed — run 'cursor-setup' to try again.${N}"; exit 1; }
fi
cursor_ok \
  || { echo -e "${R}Cursor CLI was installed but does not start on this phone.${N}"; exit 1; }
echo -e "\n${G}✓ All set! Type 'agent' (or 'cursor-agent') to start Cursor CLI.${N}"
echo -e "  Sign in with your Cursor account when it asks, or set CURSOR_API_KEY.\n"
