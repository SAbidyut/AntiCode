# Agy Terminal shell look — sourced from ~/.bashrc (rewritten when the app updates).
# Prompt styles (Settings → Prompt style, or:  agy-prompt <style>):
#   powerline  pastel segments with rounded ends (default)
#   pure       one quiet line: folder, branch, ❯ — how long a command took at the right
#   rainbow    slanted colour blocks, a rule to the right edge, time and duration there
#   lean       the same in coloured text only, no blocks
#   capsule    rounded capsules on a framed line: ╭─ … / ╰─❯
#   simple     the folder and ❯

# ---------------------------------------------------------------- ble.sh (autosuggestions)
# Fish-like grey suggestions from history (→ or End accepts), Tab completion menu and
# syntax colours. Off with:  agy-autocomplete off
if [[ $- == *i* ]] && [ -t 0 ] && [ -t 1 ] && [ -z "$CLAUDECODE" ] && [ "$TERM" != dumb ] \
   && [ -f /usr/share/blesh/ble.sh ] && [ ! -f "$HOME/.config/agy-terminal/no-autocomplete" ]; then
  source /usr/share/blesh/ble.sh --noattach
fi
# bash's own completions for apt, git, systemctl … (package: bash-completion)
if [ -z "$BASH_COMPLETION_VERSINFO" ] && [ -f /usr/share/bash-completion/bash_completion ] && [[ $- == *i* ]]; then
  . /usr/share/bash-completion/bash_completion
fi

alias ls='ls --color=auto'
alias ll='ls -alh --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'
# after clearing the screen the prompt starts at the very top, without the blank line
clear() { command clear "$@"; __agy_prompted=; }
reset() { command reset "$@"; __agy_prompted=; }

__agy_style_file="$HOME/.config/agy-terminal/prompt"

# ---------------------------------------------------------------- git branch (no subprocess)
__agy_git_branch() {
  __agy_branch=
  local d=$PWD head
  while :; do
    if [ -f "$d/.git/HEAD" ]; then
      read -r head < "$d/.git/HEAD"
      case $head in
        ref:\ refs/heads/*) __agy_branch=${head#ref: refs/heads/} ;;
        *) __agy_branch=${head:0:7} ;;
      esac
      __agy_branch=${__agy_branch//[[:cntrl:]]/?}
      return
    fi
    [ -z "$d" ] || [ "$d" = / ] && return
    d=${d%/*}
  done
}

# ---------------------------------------------------------------- prompt
# Text that comes from outside (folder names, git branches) is never put into PS1 itself —
# bash would expand $(…) in it — but referenced as ${__agy_txt[i]}.

# The path, shortened to fit [$1] characters: "…/parent/name", else "name".
__agy_fit_path() {
  __agy_p=$path
  (( ${#__agy_p} <= $1 )) && return
  local short=${path##*/} parent=${path%/*}
  parent=${parent##*/}
  [ "$path" != "$short" ] && short="…/${parent:+$parent/}$short"
  __agy_p=$short
  (( ${#__agy_p} <= $1 )) || __agy_p=${path##*/}
}

# (on the first line of a style with coloured blocks: tells the app to draw that line's text
# at the size of the Settings pictures — smaller than the terminal's text, the blocks as
# tall as now)
__agy_bar='\[\e]7770;bar\a\]'

__agy_prompt() {
  local status=$?
  __agy_in_prompt=1
  # tell the app the command is done (its "task finished" notification), and where the
  # shell is (OSC 7: a file name tapped in the terminal is looked for here)
  printf '\e]7770;done\a\e]7;file://android%s\a' "${PWD//[[:cntrl:]]/}"

  local style=powerline
  [ -r "$__agy_style_file" ] && read -r style < "$__agy_style_file"

  local path=${PWD/#$HOME/\~}
  # a folder name can't smuggle escape sequences into the title or the bar
  path=${path//[[:cntrl:]]/?}
  __agy_txt=()
  __agy_path=$path
  # a blank line between the last output and the prompt (not on the first prompt)
  local gap=
  [ -n "$__agy_prompted" ] && gap='\n'
  __agy_prompted=1
  local ok='166;227;161' bad='243;139;168'
  local mark=$ok
  (( status != 0 )) && mark=$bad
  local cols=${COLUMNS:-80}
  # how long the command took (its start noted by PS0 / ble.sh): shown from 2 s
  local took=
  if [ -n "$__agy_t0" ]; then
    local d=$(( SECONDS - __agy_t0 ))
    if (( d >= 3600 )); then took="$(( d / 3600 ))h$(( d % 3600 / 60 ))m"
    elif (( d >= 60 )); then took="$(( d / 60 ))m$(( d % 60 ))s"
    elif (( d >= 2 )); then took="${d}s"
    fi
  fi
  __agy_t0=
  local title="\[\e]0;\${__agy_path}\a\]"

  case $style in
    simple)
      PS1="${gap}${title}\[\e[38;2;137;220;235m\]\${__agy_path}\[\e[0m\] \[\e[38;2;${mark}m\]❯\[\e[0m\] "
      ;;
    pure) __agy_git_branch; __agy_ps_pure ;;
    rainbow) __agy_git_branch; __agy_ps_bar rainbow ;;
    lean) __agy_git_branch; __agy_ps_bar lean ;;
    capsule) __agy_git_branch; __agy_ps_capsule ;;
    *) __agy_git_branch; __agy_ps_powerline ;;
  esac
  __agy_in_prompt=
}

# pure — one quiet line: the folder (blue), the branch (green), ❯ (red after a failure);
# how long the last command took appears at the right edge (drawn by the app)
__agy_ps_pure() {
  __agy_fit_path $(( cols - 6 - ${#__agy_branch} ))
  __agy_txt=("$__agy_p" "$__agy_branch")
  local line="\[\e[38;2;116;169;233m\]\${__agy_txt[0]}"
  [ -n "$__agy_branch" ] && line+=" \[\e[38;2;140;200;120m\]\${__agy_txt[1]}"
  local note=
  [ -n "$took" ] && note="\[\e]7770;rnote;${took}\a\]"
  PS1="${gap}${note}${title}${line} \[\e[38;2;${mark}m\]❯\[\e[0m\] "
}

# rainbow / lean — the first line runs to the right edge: on the left the system, the folder
# and the branch; on the right the failed status, how long the command took and the time,
# a thin rule between. rainbow: slanted colour blocks; lean: the same as coloured text.
# The ❯ waits on the second line.
__agy_ps_bar() {
  local kind=$1 time
  # the parts as "background|foreground|text" (lean uses only the foreground); a phone held
  # upright gets the short forms ("16:23", "5s")
  local -a L=() R=() RK=()
  local wide=1
  (( cols < 72 )) && wide=
  L+=("58;58;64|220;220;225| "$'\uf17c'"  ")
  L+=("38;100;190|240;244;250| "$'\uf07b'"  @PATH ")
  if [ -n "$__agy_branch" ]; then
    if [ -n "$wide" ]; then L+=("88;148;40|20;24;16| on "$'\ue0a0'"  @BRANCH ")
    else L+=("88;148;40|20;24;16| "$'\ue0a0'"  @BRANCH "); fi
  fi
  # lean: plain text, one space after an icon is enough
  if [ "$kind" = lean ]; then local j; for j in "${!L[@]}"; do L[j]=${L[j]//  / }; done; fi
  (( status != 0 )) && R+=("204;62;62|250;240;240| "$'\uf071'" ${status} ") && RK+=(status)
  if [ -n "$wide" ]; then
    printf -v time '%(%H:%M:%S)T' -1
    [ -n "$took" ] && R+=("196;160;0|30;26;0| took ${took} "$'\uf252'" ") && RK+=(took)
    R+=("200;200;204|28;28;32| at ${time} "$'\uf017'" ") && RK+=(time)
  else
    printf -v time '%(%H:%M)T' -1
    [ -n "$took" ] && R+=("196;160;0|30;26;0| ${took} "$'\uf252'" ") && RK+=(took)
    R+=("200;200;204|28;28;32| ${time} "$'\uf017'" ") && RK+=(time)
  fi
  # widths: each part plus its separator; the path shortened to leave room for the rule
  # (rainbow draws a slanted separator per part; lean none — counted, its rule fell short)
  local i t wl=0 wr=0 sep=1
  [ "$kind" = lean ] && sep=0
  for i in "${L[@]}"; do t=${i##*|}; t=${t/@PATH/}; t=${t/@BRANCH/$__agy_branch}; wl=$(( wl + ${#t} + sep )); done
  for i in "${R[@]}"; do t=${i##*|}; wr=$(( wr + ${#t} + sep )); done
  # still too narrow: the right side's parts go, the time first (the folder keeps at least its own name)
  local need=${path##*/}
  need=${#need}
  (( need < 1 )) && need=1
  (( need > 16 )) && need=16
  while (( ${#R[@]} > 0 )) && (( cols - wl - wr - 3 < need )); do
    t=${R[-1]##*|}; wr=$(( wr - ${#t} - sep )); unset 'R[-1]'
  done
  __agy_fit_path $(( cols - wl - wr - 3 ))
  __agy_txt=("$__agy_p" "$__agy_branch")
  wl=$(( wl + ${#__agy_p} ))
  local fill=$(( cols - wl - wr - 2 ))
  (( fill < 1 )) && fill=1
  local rule
  printf -v rule '%*s' "$fill" ''
  rule=${rule// /─}

  local line= n=${#L[@]} bg fg tx next
  for (( i = 0; i < n; i++ )); do
    bg=${L[i]%%|*}; fg=${L[i]#*|}; fg=${fg%%|*}; tx=${L[i]##*|}
    tx=${tx/@PATH/\$\{__agy_txt[0]\}}; tx=${tx/@BRANCH/\$\{__agy_txt[1]\}}
    if [ "$kind" = lean ]; then
      # the folder blue, the branch green, the rest grey — no blocks
      case $i in 1) fg='116;169;233' ;; 2) fg='140;200;120' ;; *) fg='150;150;160' ;; esac
      line+="\[\e[38;2;${fg}m\]${tx}"
      continue
    fi
    line+="\[\e[48;2;${bg}m\e[38;2;${fg}m\]${tx}"
    if (( i + 1 < n )); then next=${L[i + 1]%%|*}; line+="\[\e[48;2;${next}m\e[38;2;${bg}m\]"$'\ue0bc'
    else line+="\[\e[0m\e[38;2;${bg}m\]"$'\ue0bc'
    fi
  done
  line+="\[\e[0m\e[38;2;88;88;98m\] ${rule} "
  local prev= k=0
  for i in "${R[@]}"; do
    bg=${i%%|*}; fg=${i#*|}; fg=${fg%%|*}; tx=${i##*|}
    if [ "$kind" = lean ]; then
      case ${RK[k++]} in took) fg='220;190;90' ;; time) fg='150;150;160' ;; *) fg='240;110;110' ;; esac
      line+="\[\e[38;2;${fg}m\]${tx}"
      continue
    fi
    if [ -n "$prev" ]; then line+="\[\e[48;2;${prev}m"; else line+="\[\e[49m"; fi
    line+="\e[38;2;${bg}m\]"$'\ue0ba'"\[\e[48;2;${bg}m\e[38;2;${fg}m\]${tx}"
    prev=$bg
  done
  line+="\[\e[0m\]"
  # (lean has no blocks: its text stays the terminal's size)
  local bar=
  [ "$kind" = rainbow ] && bar=$__agy_bar
  PS1="${gap}${bar}${title}${line}\n\[\e[38;2;${mark}m\]❯\[\e[0m\] "
}

# capsule — rounded capsules with a short line between, framed: ╭─ … on top, ╰─❯ below; the
# clock at the right edge (drawn by the app)
__agy_ps_capsule() {
  local -a C=()
  C+=("203;166;247|"$'\uf007'" ${USER:-root}")
  C+=("137;180;250|"$'\uf07b'" @PATH")
  [ -n "$__agy_branch" ] && C+=("166;227;161|"$'\ue0a0'" @BRANCH")
  (( status != 0 )) && C+=("243;139;168|"$'\uf071'" ${status}")
  local clock= w i t
  (( cols >= 34 )) && printf -v clock '%(%-I:%M %p)T' -1
  __agy_cw() {
    w=-1
    for i in "${C[@]}"; do t=${i#*|}; t=${t/@PATH/}; t=${t/@BRANCH/$__agy_branch}; w=$(( w + ${#t} + 5 )); done
  }
  __agy_cw
  # narrow: the clock goes first, then the user's capsule (the folder keeps at least its own name)
  local need=${path##*/}
  need=${#need}
  (( need < 1 )) && need=1
  (( need > 16 )) && need=16
  local room=$(( cols - 1 - (${#clock} ? ${#clock} + 6 : 0) ))
  if (( room - w < need )) && [ -n "$clock" ]; then clock=; room=$(( cols - 1 )); fi
  if (( room - w < need )); then C=("${C[@]:1}"); __agy_cw; fi
  __agy_fit_path $(( room - w ))
  __agy_txt=("$__agy_p" "$__agy_branch")
  local rclock=
  [ -n "$clock" ] && (( w + ${#__agy_p} <= room )) && rclock="\[\e]7770;rprompt;${clock}\a\]"
  local frame='108;112;134' line="\[\e[38;2;108;112;134m\]╭─" bg tx k=0
  for i in "${C[@]}"; do
    bg=${i%%|*}; tx=${i#*|}
    tx=${tx/@PATH/\$\{__agy_txt[0]\}}; tx=${tx/@BRANCH/\$\{__agy_txt[1]\}}
    (( k++ )) && line+="\[\e[0m\e[38;2;${frame}m\] ─ "
    line+="\[\e[0m\e[38;2;${bg}m\]"$'\ue0b6'"\[\e[48;2;${bg}m\e[38;2;30;30;46m\]${tx}\[\e[0m\e[38;2;${bg}m\]"$'\ue0b4'
  done
  line+="\[\e[0m\]"
  PS1="${gap}${__agy_bar}${rclock}${title}${line}\n\[\e[38;2;${frame}m\]╰─\[\e[38;2;${mark}m\]❯\[\e[0m\] "
}

# powerline — pastel segments with rounded ends; the clock at the right edge (the app draws
# it there, so it isn't text the bar could run into)
__agy_ps_powerline() {
  local clock= rclock=
  (( cols >= 30 )) && printf -v clock '%(%-I:%M %p)T' -1

  # segments: "r;g;b|icon text" — dark text on pastel backgrounds
  local dir_icon=$'\uf07b'
  [ "$PWD" = "$HOME" ] && dir_icon=$'\uf015'
  local -a segs=()
  segs+=("245;169;127|"$'\uf007'" ${USER:-root}")
  segs+=("243;139;168|${dir_icon} ${path}")
  [ -n "$__agy_branch" ] && segs+=("249;226;175|"$'\ue0a0'" ${__agy_branch}")
  (( status != 0 )) && segs+=("235;111;146|"$'\uf071'" ${status}")

  # Fit the phone's width (leaving room for the clock): shorten the path.
  local width i room=$(( cols - 1 - (${#clock} ? ${#clock} + 6 : 0) ))
  __agy_width() {
    local t
    width=2
    for i in "${segs[@]}"; do t=${i#*|}; width=$(( width + ${#t} + 3 )); done
  }
  __agy_width
  if (( width > room )); then
    local short=${path##*/}
    local parent=${path%/*}; parent=${parent##*/}
    [ "$path" != "$short" ] && short="…/${parent:+$parent/}$short"
    segs[1]="243;139;168|${dir_icon} ${short}"
    __agy_width
    (( width > room )) && segs[1]="243;139;168|${dir_icon} ${path##*/}" && __agy_width
  fi

  # the clock only if it won't cover the bar
  [ -n "$clock" ] && (( width <= room )) && rclock="\[\e]7770;rprompt;${clock}\a\]"

  local fg='30;30;46' line= n=${#segs[@]} bg next
  for (( i = 0; i < n; i++ )); do
    bg=${segs[i]%%|*}
    (( i == 0 )) && line+="\[\e[0m\e[38;2;${bg}m\]"$'\ue0b6'
    __agy_txt[i]=${segs[i]#*|}
    line+="\[\e[48;2;${bg}m\e[38;2;${fg}m\] \${__agy_txt[$i]} "
    if (( i + 1 < n )); then
      next=${segs[i + 1]%%|*}
      line+="\[\e[48;2;${next}m\e[38;2;${bg}m\]"$'\ue0b0'
    else
      line+="\[\e[0m\e[38;2;${bg}m\]"$'\ue0b4'"\[\e[0m\]"
    fi
  done

  # window title (shown on the app's tab) + segments + input line
  PS1="${gap}${__agy_bar}${rclock}${title}${line}\n\[\e[38;2;${mark}m\]❯\[\e[0m\] "
}
PROMPT_COMMAND=__agy_prompt
# a command starts (the app's "task finished" notification waits for the prompt again); its
# start time is noted for the prompt's "took 5s" (the empty slice prints nothing — the
# arithmetic sets the variable)
PS0=$'\e]7770;exec\a''${PS0:0:$((__agy_t0=SECONDS,0))}'

# ---------------------------------------------------------------- agents on demand
# Typing 'agy' or 'claude' before they are installed installs them first.
command_not_found_handle() {
  case "$1" in
    agy) /usr/local/bin/agy-setup --auto && hash -r && command agy "${@:2}"; return ;;
    claude) /usr/local/bin/claude-setup --auto && hash -r && command claude "${@:2}"; return ;;
  esac
  if [ -x /usr/lib/command-not-found ]; then /usr/lib/command-not-found -- "$1"; return $?; fi
  printf '%s: command not found\n' "$1" >&2
  return 127
}
# Antigravity counts a Bangla conjunct (ক্ষ) as one character, as Unicode 15.1 does; the shell
# and other programs (Claude Code too) count its letters. The terminal draws it the program's
# way, so the program's tables and input line come out right (back to letters at the prompt).
agy() { printf '\e]7770;widths;joined\a'; command agy "$@"; }

# ---------------------------------------------------------------- ble.sh look & attach
if [[ ${BLE_VERSION-} ]]; then
  bleopt char_width_mode=west          # same widths as the app's renderer, no terminal probing
  # Typing stays quick under proot, where every file check and every program started is slow:
  # - grey suggestions come from the history only. The completion system behind the other
  #   kind runs programs (git, apt …) and lists every command in $PATH at each pause, and
  #   the keys typed meanwhile waited. (Tab still completes as before.)
  blehook/eval-after-load complete '_ble_complete_auto_source=(history)'
  # - the history search is cheap and gives way to the next key: the suggestion shows with
  #   the letter typed, not a moment later as a separate redraw
  bleopt complete_auto_delay=30
  # - no file checks for every word typed (a stat per word, per key; on /storage each is
  #   slow), and no second redraw when they ran late
  bleopt highlight_filename=
  bleopt highlight_timeout_sync=20 complete_timeout_auto=800 2>/dev/null
  bleopt complete_menu_style=align-nowrap
  bleopt edit_abell= edit_vbell=       # no beeps or flashes
  bleopt exec_errexit_mark=            # the prompt already shows a failed command's status
  bleopt exec_elapsed_mark=            # no "[ble: elapsed …]" lines
  # After a resize (zooming changes the width), redraw the prompt where it was. The
  # default guesses how the terminal re-wrapped it and gets it wrong for a two-line
  # prompt: every zoom left an extra blank line or a copy of the prompt bar behind.
  bleopt canvas_winch_action=redraw-prev
  bleopt prompt_eol_mark=$'\e[38;2;108;112;134m⏎\e[m'
  ble-face auto_complete='fg=#6c7086'
  # Calm colours. The command word is green as it's typed: with the file checks off it isn't
  # looked up (its colour would be ble.sh's "brown" — this theme's red, every command looking
  # wrong), and it doesn't flash red while half typed. A syntax error is soft red text.
  ble-face syntax_command='fg=#a6e3a1'
  ble-face command_builtin='fg=#a6e3a1' command_file='fg=#a6e3a1' command_function='fg=#cba6f7'
  ble-face command_alias='fg=#a6e3a1' command_keyword='fg=#89b4fa'
  ble-face syntax_quoted='fg=#f9e2af' syntax_comment='fg=#6c7086' syntax_error='fg=#eba0ac'
  ble-face region='bg=#45475a'
  # ⌫ removes a whole letter cluster — a letter with its vowel signs, a conjunct (ক্ষ) —
  # like Claude Code and the app's Bangla keyboard do (ble.sh itself removes one code point).
  function ble/widget/anticode-delete-backward-cluster {
    local s=$_ble_edit_str i=$_ble_edit_ind b ret c k
    ((i>0)) || { ble/widget/.bell; return 1; }
    ble/unicode/GraphemeCluster/find-previous-boundary "$s" "$i"; b=$ret
    # conjuncts: consonant + virama (+ ZWJ) + consonant stay together (Unicode GB9c) — the
    # same rule the app's keyboard counts with
    while ((b>=2)); do
      k=$((b-1))
      ble/util/s2c "${s:k:1}"
      if ((ret==0x200D)); then ((k>=1)) || break; ((k--)); ble/util/s2c "${s:k:1}"; fi
      ((ret==0x9CD||ret==0x94D)) || break
      ble/util/s2c "${s:b:1}"; c=$ret
      ((0x995<=c&&c<=0x9B9||c==0x9DC||c==0x9DD||c==0x9DF||c==0x9F0||c==0x9F1||0x915<=c&&c<=0x939||0x958<=c&&c<=0x95F||0x978<=c&&c<=0x97F)) || break
      ble/unicode/GraphemeCluster/find-previous-boundary "$s" "$b"; k=$ret
      # only a chain that starts with a consonant ("অ্যা" is অ্ + যা)
      ble/util/s2c "${s:k:1}"; c=$ret
      ((0x995<=c&&c<=0x9B9||c==0x9DC||c==0x9DD||c==0x9DF||c==0x9F0||c==0x9F1||0x915<=c&&c<=0x939||0x958<=c&&c<=0x95F||0x978<=c&&c<=0x97F)) || break
      b=$k
    done
    ((b<i)) || b=$((i-1))
    ble/widget/.delete-char "$((b-i))" || ble/widget/.bell
  }
  function anticode/ble-keys {
    ble-bind -m emacs -f 'DEL' 'delete-region-or anticode-delete-backward-cluster'
    ble-bind -m emacs -f 'C-?' 'delete-region-or anticode-delete-backward-cluster'
    ble-bind -m emacs -f 'C-h' 'delete-region-or anticode-delete-backward-cluster'
  }
  blehook/eval-after-load keymap_emacs anticode/ble-keys 2>/dev/null || anticode/ble-keys
  # (ble.sh runs commands itself: say when one starts from its hook as well — with the
  # command's name, so the app knows an agent started however the line was typed)
  function __agy_preexec {
    local w=${1#"${1%%[![:space:]]*}"}
    w=${w%%[[:space:]]*}
    w=${w//[[:cntrl:];]/}
    printf '\e]7770;exec;%s\a' "${w:0:40}"
    __agy_t0=$SECONDS
  }
  blehook PREEXEC+='__agy_preexec "$1"' 2>/dev/null
  ble-attach
fi
