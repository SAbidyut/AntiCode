# Agy Terminal shell look — sourced from ~/.bashrc (rewritten when the app updates).
# Prompt styles (Settings → Prompt style, or:  agy-prompt <style>):
#   powerline  pastel segments with rounded ends (default)
#   pure       one quiet line: folder, branch, ❯ — how long a command took at the right
#   rainbow    slanted colour blocks, a rule to the right edge, time and duration there
#   lean       the same in coloured text only, no blocks
#   capsule    rounded capsules on a framed line: ╭─ … / ╰─❯
#   simple     the folder and ❯

# ---------------------------------------------------------------- ble.sh (autosuggestions)
# Fish-like grey suggestions from history (→ or End accepts), Tab completion menu and
# syntax colours. Off with:  agy-autocomplete off
if [[ $- == *i* ]] && [ -t 0 ] && [ -t 1 ] && [ -z "${CLAUDECODE-}" ] && [ "${TERM-}" != dumb ] \
   && [ -f /usr/share/blesh/ble.sh ] && [ ! -f "$HOME/.config/agy-terminal/no-autocomplete" ]; then
  source /usr/share/blesh/ble.sh --noattach
fi
# bash's own completions for apt, git, systemctl … (package: bash-completion)
if [ -z "${BASH_COMPLETION_VERSINFO-}" ] && [ -f /usr/share/bash-completion/bash_completion ] && [[ $- == *i* ]]; then
  . /usr/share/bash-completion/bash_completion
fi

alias ls='ls --color=auto'
alias ll='ls -alh --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'
# after clearing the screen the prompt starts at the very top, without the blank line
clear() { command clear "$@"; __agy_prompted=; }
reset() { command reset "$@"; __agy_prompted=; }

__agy_style_file="$HOME/.config/agy-terminal/prompt"
# The app's messages (OSC 7770: the prompt's clock, "a command started" …) carry the token
# the app gave this shell: the same text printed by anything else — `cat` of a file, a
# program's output — is ignored, so it can't fake a clock, the agent layout or widths.
__agy_tok=${ANTICODE_LINK_TOKEN:-}

# ---------------------------------------------------------------- git branch (no subprocess)
__agy_git_branch() {
  __agy_branch=
  local d=$PWD head g hf
  while :; do
    hf=
    if [ -f "$d/.git/HEAD" ]; then hf=$d/.git/HEAD
    elif [ -f "$d/.git" ]; then
      # a worktree or a submodule: .git is a file naming the real git folder
      read -r g < "$d/.git"
      g=${g#gitdir: }
      [[ $g == /* ]] || g=$d/$g
      [ -f "$g/HEAD" ] && hf=$g/HEAD
    fi
    if [ -n "$hf" ]; then
      read -r head < "$hf"
      case $head in
        ref:\ refs/heads/*) __agy_branch=${head#ref: refs/heads/} ;;
        *) __agy_branch=${head:0:7} ;;
      esac
      __agy_branch=${__agy_branch//[[:cntrl:]]/?}
      return
    fi
    [ -z "$d" ] || [ "$d" = / ] && return
    d=${d%/*}
  done
}

# ---------------------------------------------------------------- prompt
# Text that comes from outside (folder names, git branches) is never put into PS1 itself —
# bash would expand $(…) in it — but referenced as ${__agy_txt[i]}.

# How many cells [$1] takes in the terminal → __agy_n: Chinese/Japanese/Korean and emoji 2,
# vowel signs, viramas and joiners 0 (they join the letter before, as the terminal draws
# them), the rest 1. (${#s} counts characters: a CJK folder name ran past the edge, a Bangla
# one left a gap.)
__agy_w() {
  local s=$1
  if [[ $s != *[![:ascii:]]* ]]; then __agy_n=${#s}; return; fi
  local i c n=0 joined=
  for (( i = 0; i < ${#s}; i++ )); do
    printf -v c '%d' "'${s:i:1}"
    if [ -n "$joined" ]; then joined=; continue; fi # (the emoji after a ZWJ joins the one before)
    if (( c == 0x200D )); then joined=1; continue; fi
    if (( (c >= 0x300 && c <= 0x36F) || (c >= 0x900 && c <= 0x903) || (c >= 0x93A && c <= 0x94F) ||
      (c >= 0x951 && c <= 0x957) || (c >= 0x962 && c <= 0x963) || (c >= 0x981 && c <= 0x983) ||
      c == 0x9BC || (c >= 0x9BE && c <= 0x9CD) || c == 0x9D7 || (c >= 0x9E2 && c <= 0x9E3) ||
      c == 0x200B || c == 0x200C || (c >= 0xFE00 && c <= 0xFE0F) )); then continue; fi
    if (( (c >= 0x1100 && c <= 0x115F) || (c >= 0x2E80 && c <= 0x303E) || (c >= 0x3041 && c <= 0x33FF) ||
      (c >= 0x3400 && c <= 0x4DBF) || (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0xA000 && c <= 0xA4CF) ||
      (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0xF900 && c <= 0xFAFF) || (c >= 0xFE30 && c <= 0xFE4F) ||
      (c >= 0xFF00 && c <= 0xFF60) || (c >= 0xFFE0 && c <= 0xFFE6) || (c >= 0x1F300 && c <= 0x1F64F) ||
      (c >= 0x1F680 && c <= 0x1F6FF) || (c >= 0x1F900 && c <= 0x1F9FF) || (c >= 0x1FA70 && c <= 0x1FAFF) ||
      (c >= 0x20000 && c <= 0x3FFFD) )); then n=$(( n + 2 )); else n=$(( n + 1 )); fi
  done
  __agy_n=$n
}

# [$2] cut to at most [$3] cells with "…" → __agy_c: [$1] = tail keeps its end ("…older"),
# head keeps its start ("feat/lo…").
__agy_cut() {
  local s=$2 max=$3
  __agy_w "$s"
  if (( __agy_n <= max )); then __agy_c=$s; return; fi
  if (( max <= 1 )); then __agy_c=…; return; fi
  # one pass: letters taken from the end that's kept, each measured once, while they fit
  # (re-measuring the rest after every letter was slow for a long Bangla or Chinese name)
  local keep= ch used=0 i n=${#s}
  for (( i = 0; i < n; i++ )); do
    if [ "$1" = tail ]; then ch=${s:n-1-i:1}; else ch=${s:i:1}; fi
    __agy_w "$ch"
    (( used + __agy_n > max - 1 )) && break
    (( used += __agy_n ))
    if [ "$1" = tail ]; then keep=$ch$keep; else keep+=$ch; fi
  done
  if [ "$1" = tail ]; then
    # (not starting on a vowel sign: it would be drawn on a dotted circle)
    while [ -n "$keep" ]; do __agy_w "${keep:0:1}"; (( __agy_n == 0 )) || break; keep=${keep:1}; done
    __agy_c=…$keep
  else __agy_c=$keep…; fi
}

# The path, shortened to fit [$1] cells: "…/parent/name", else "name", else the name's end.
__agy_fit_path() {
  __agy_p=$path
  __agy_w "$__agy_p"; (( __agy_n <= $1 )) && return
  local name=${path##*/} parent=${path%/*}
  [ -n "$name" ] || name=$path
  parent=${parent##*/}
  if [ "$path" != "$name" ]; then
    __agy_p="…/${parent:+$parent/}$name"
    __agy_w "$__agy_p"; (( __agy_n <= $1 )) && return
  fi
  __agy_p=$name
  __agy_w "$__agy_p"; (( __agy_n <= $1 )) && return
  __agy_cut tail "$name" "$1"
  __agy_p=$__agy_c
}

# The room the folder keeps before other parts make way (its name, up to 12 cells) → __agy_need
__agy_folder_need() {
  local name=${path##*/}
  [ -n "$name" ] || name=$path
  __agy_w "$name"
  __agy_need=$__agy_n
  (( __agy_need < 1 )) && __agy_need=1
  (( __agy_need > 12 )) && __agy_need=12
  return 0
}

# (on the first line of a style with coloured blocks: tells the app to draw that line's text
# at the size of the Settings pictures — smaller than the terminal's text, the blocks as
# tall as now)
__agy_bar="\[\e]7770;bar;${__agy_tok}\a\]"

__agy_prompt() {
  local status=$?
  # (the user's set -e / -u / -x don't break the prompt — nor print hundreds of trace lines;
  # their options come back as they were after it)
  local -
  set +eux
  __agy_in_prompt=1
  # (each command saved at once: a tab closed or killed keeps its history for the suggestions)
  history -a 2>/dev/null
  # tell the app the command is done (its "task finished" notification), and where the
  # shell is (OSC 7: a file name tapped in the terminal is looked for here)
  printf '\e]7770;done;%s\a\e]7;file://android-%s%s\a' "$__agy_tok" "$__agy_tok" "${PWD//[[:cntrl:]]/}"

  local style=powerline
  [ -r "$__agy_style_file" ] && read -r style < "$__agy_style_file"

  local path=$PWD
  # (only home itself or what's in it: /root-backup isn't ~-backup)
  [[ $PWD == "$HOME" || $PWD == "$HOME"/* ]] && path=\~${PWD#"$HOME"}
  # a folder name can't smuggle escape sequences into the title or the bar
  path=${path//[[:cntrl:]]/?}
  __agy_txt=()
  __agy_path=$path
  local cols=${COLUMNS:-80}
  # ble.sh runs this again when the width changes: the same prompt, drawn anew where it was
  local redraw=
  [[ ${BLE_VERSION-} ]] && [ -z "$__agy_t0" ] && [ -n "$__agy_cols" ] && [ "$cols" != "$__agy_cols" ] && redraw=1
  # A blank line between the last output and the prompt (not on the first prompt, nor after
  # clear). Printed here, not part of PS1: Ctrl-L draws PS1 again at the top of a cleared
  # screen, and a blank line there pushed the prompt down a row.
  [ -n "$__agy_prompted" ] && [ -z "$redraw" ] && printf '\n'
  __agy_prompted=1
  local ok='166;227;161' bad='243;139;168'
  local mark=$ok
  (( status != 0 )) && mark=$bad
  # how long the command took (its start noted by PS0 / ble.sh): shown from 2 s
  local took=
  if [ -n "$__agy_t0" ]; then
    local d=$(( SECONDS - __agy_t0 ))
    if (( d >= 3600 )); then took="$(( d / 3600 ))h$(( d % 3600 / 60 ))m"
    elif (( d >= 60 )); then took="$(( d / 60 ))m$(( d % 60 ))s"
    elif (( d >= 2 )); then took="${d}s"
    fi
    __agy_took=$took
  elif [ -n "$redraw" ]; then
    took=$__agy_took # (drawn again for a new width: the same command's time)
  else
    __agy_took=
  fi
  __agy_cols=$cols
  __agy_t0=
  local title="\[\e]0;\${__agy_path}\a\]"

  case $style in
    simple)
      # (the folder shortened to leave room to type: at most half the width, or all but 24)
      local room=$(( cols - 24 ))
      (( room < cols / 2 )) && room=$(( cols / 2 ))
      __agy_fit_path "$room"
      __agy_txt=("$__agy_p")
      PS1="${title}\[\e[38;2;137;220;235m\]\${__agy_txt[0]}\[\e[0m\] \[\e[38;2;${mark}m\]❯\[\e[0m\] "
      ;;
    *)
      # the branch as shown: a long one cut to a quarter of the width (at least 8 cells)
      __agy_git_branch
      local bmax=$(( cols / 4 ))
      (( bmax < 8 )) && bmax=8
      __agy_cut head "$__agy_branch" "$bmax"
      __agy_b=$__agy_c
      __agy_folder_need
      case $style in
        pure) __agy_ps_pure ;;
        rainbow) __agy_ps_bar rainbow ;;
        lean) __agy_ps_bar lean ;;
        capsule) __agy_ps_capsule ;;
        *) __agy_ps_powerline ;;
      esac
      ;;
  esac
  __agy_in_prompt=
}

# pure — one quiet line: the folder (blue), the branch (green), ❯ (red after a failure);
# how long the last command took appears at the right edge (drawn by the app)
__agy_ps_pure() {
  __agy_w "$__agy_b"
  __agy_fit_path $(( cols - 6 - __agy_n ))
  __agy_txt=("$__agy_p" "$__agy_b")
  local line="\[\e[38;2;116;169;233m\]\${__agy_txt[0]}"
  [ -n "$__agy_b" ] && line+=" \[\e[38;2;140;200;120m\]\${__agy_txt[1]}"
  local note=
  [ -n "$took" ] && note="\[\e]7770;rnote;${__agy_tok};${took}\a\]"
  PS1="${note}${title}${line} \[\e[38;2;${mark}m\]❯\[\e[0m\] "
}

# rainbow / lean — the first line runs to the right edge: on the left the system, the folder
# and the branch; on the right the failed status, how long the command took and the time,
# a thin rule between. rainbow: slanted colour blocks; lean: the same as coloured text.
# The ❯ waits on the second line.
__agy_ps_bar() {
  local kind=$1 time
  # the parts as "background|foreground|text" (lean uses only the foreground); a phone held
  # upright gets the short forms ("16:23", "5s")
  local -a L=() R=() RK=()
  local wide=1
  (( cols < 72 )) && wide=
  L+=("58;58;64|220;220;225| "$'\uf17c'"  ")
  L+=("38;100;190|240;244;250| "$'\uf07b'"  @PATH ")
  if [ -n "$__agy_b" ]; then
    if [ -n "$wide" ]; then L+=("88;148;40|20;24;16| on "$'\ue0a0'"  @BRANCH ")
    else L+=("88;148;40|20;24;16| "$'\ue0a0'"  @BRANCH "); fi
  fi
  # lean: plain text, one space after an icon is enough
  if [ "$kind" = lean ]; then local j; for j in "${!L[@]}"; do L[j]=${L[j]//  / }; done; fi
  (( status != 0 )) && R+=("204;62;62|250;240;240| "$'\uf071'" ${status} ") && RK+=(status)
  if [ -n "$wide" ]; then
    printf -v time '%(%H:%M:%S)T' -1
    [ -n "$took" ] && R+=("196;160;0|30;26;0| took ${took} "$'\uf252'" ") && RK+=(took)
    R+=("200;200;204|28;28;32| at ${time} "$'\uf017'" ") && RK+=(time)
  else
    printf -v time '%(%H:%M)T' -1
    [ -n "$took" ] && R+=("196;160;0|30;26;0| ${took} "$'\uf252'" ") && RK+=(took)
    R+=("200;200;204|28;28;32| ${time} "$'\uf017'" ") && RK+=(time)
  fi
  # widths: each part plus its separator; the path shortened to leave room for the rule
  # (rainbow draws a slanted separator per part; lean none — counted, its rule fell short)
  local i t wl wr=0 sep=1
  [ "$kind" = lean ] && sep=0
  __agy_bar_wl() {
    wl=0
    for i in "${L[@]}"; do t=${i##*|}; t=${t/@PATH/}; t=${t/@BRANCH/"$__agy_b"}; __agy_w "$t"; wl=$(( wl + __agy_n + sep )); done
  }
  __agy_bar_wl
  for i in "${R[@]}"; do t=${i##*|}; __agy_w "$t"; wr=$(( wr + __agy_n + sep )); done
  # still too narrow: the right side's parts go, the time first, then the branch (the folder
  # keeps its name, up to 12 cells; after that it's cut)
  while (( ${#R[@]} > 0 )) && (( cols - wl - wr - 3 < __agy_need )); do
    t=${R[-1]##*|}; __agy_w "$t"; wr=$(( wr - __agy_n - sep )); unset 'R[-1]' 'RK[-1]'
  done
  if (( ${#L[@]} > 2 )) && (( cols - wl - wr - 3 < __agy_need )); then unset 'L[2]'; __agy_bar_wl; fi
  __agy_fit_path $(( cols - wl - wr - 3 ))
  __agy_txt=("$__agy_p" "$__agy_b")
  __agy_w "$__agy_p"
  wl=$(( wl + __agy_n ))
  local fill=$(( cols - wl - wr - 2 ))
  (( fill < 1 )) && fill=1
  local rule
  printf -v rule '%*s' "$fill" ''
  rule=${rule// /─}

  local line= n=${#L[@]} bg fg tx next
  for (( i = 0; i < n; i++ )); do
    bg=${L[i]%%|*}; fg=${L[i]#*|}; fg=${fg%%|*}; tx=${L[i]##*|}
    tx=${tx/@PATH/\$\{__agy_txt[0]\}}; tx=${tx/@BRANCH/\$\{__agy_txt[1]\}}
    if [ "$kind" = lean ]; then
      # the folder blue, the branch green, the rest grey — no blocks
      case $i in 1) fg='116;169;233' ;; 2) fg='140;200;120' ;; *) fg='150;150;160' ;; esac
      line+="\[\e[38;2;${fg}m\]${tx}"
      continue
    fi
    line+="\[\e[48;2;${bg}m\e[38;2;${fg}m\]${tx}"
    if (( i + 1 < n )); then next=${L[i + 1]%%|*}; line+="\[\e[48;2;${next}m\e[38;2;${bg}m\]"$'\ue0bc'
    else line+="\[\e[0m\e[38;2;${bg}m\]"$'\ue0bc'
    fi
  done
  line+="\[\e[0m\e[38;2;88;88;98m\] ${rule} "
  local prev= k=0
  for i in "${R[@]}"; do
    bg=${i%%|*}; fg=${i#*|}; fg=${fg%%|*}; tx=${i##*|}
    if [ "$kind" = lean ]; then
      case ${RK[k++]} in took) fg='220;190;90' ;; time) fg='150;150;160' ;; *) fg='240;110;110' ;; esac
      line+="\[\e[38;2;${fg}m\]${tx}"
      continue
    fi
    if [ -n "$prev" ]; then line+="\[\e[48;2;${prev}m"; else line+="\[\e[49m"; fi
    line+="\e[38;2;${bg}m\]"$'\ue0ba'"\[\e[48;2;${bg}m\e[38;2;${fg}m\]${tx}"
    prev=$bg
  done
  line+="\[\e[0m\]"
  # (lean has no blocks: its text stays the terminal's size)
  local bar=
  [ "$kind" = rainbow ] && bar=$__agy_bar
  PS1="${bar}${title}${line}\n\[\e[38;2;${mark}m\]❯\[\e[0m\] "
}

# capsule — rounded capsules with a short line between, framed: ╭─ … on top, ╰─❯ below; the
# clock at the right edge (drawn by the app)
__agy_ps_capsule() {
  local -a C=()
  C+=("203;166;247|"$'\uf007'" ${USER:-root}")
  C+=("137;180;250|"$'\uf07b'" @PATH")
  [ -n "$__agy_b" ] && C+=("166;227;161|"$'\ue0a0'" @BRANCH")
  (( status != 0 )) && C+=("243;139;168|"$'\uf071'" ${status}")
  local clock= w i t
  (( cols >= 34 )) && printf -v clock '%(%-I:%M %p)T' -1
  # (╭─, each capsule its text and two ends, " ─ " between)
  __agy_cw() {
    w=-1
    for i in "${C[@]}"; do t=${i#*|}; t=${t/@PATH/}; t=${t/@BRANCH/"$__agy_b"}; __agy_w "$t"; w=$(( w + __agy_n + 5 )); done
  }
  __agy_cw
  # narrow: the clock goes first, then the user's capsule, then the branch's (the folder keeps
  # its name, up to 12 cells; after that it's cut)
  local room=$(( cols - 1 - (${#clock} ? ${#clock} + 6 : 0) ))
  if (( room - w < __agy_need )) && [ -n "$clock" ]; then clock=; room=$(( cols - 1 )); fi
  if (( room - w < __agy_need )); then C=("${C[@]:1}"); __agy_cw; fi
  if (( room - w < __agy_need )) && [[ ${C[1]} == *@BRANCH* ]]; then unset 'C[1]'; C=("${C[@]}"); __agy_cw; fi
  __agy_fit_path $(( room - w ))
  __agy_txt=("$__agy_p" "$__agy_b")
  local rclock=
  [ -n "$clock" ] && rclock="\[\e]7770;rprompt;${__agy_tok};${clock}\a\]"
  local frame='108;112;134' line="\[\e[38;2;108;112;134m\]╭─" bg tx k=0
  for i in "${C[@]}"; do
    bg=${i%%|*}; tx=${i#*|}
    tx=${tx/@PATH/\$\{__agy_txt[0]\}}; tx=${tx/@BRANCH/\$\{__agy_txt[1]\}}
    (( k++ )) && line+="\[\e[0m\e[38;2;${frame}m\] ─ "
    line+="\[\e[0m\e[38;2;${bg}m\]"$'\ue0b6'"\[\e[48;2;${bg}m\e[38;2;30;30;46m\]${tx}\[\e[0m\e[38;2;${bg}m\]"$'\ue0b4'
  done
  line+="\[\e[0m\]"
  PS1="${__agy_bar}${rclock}${title}${line}\n\[\e[38;2;${frame}m\]╰─\[\e[38;2;${mark}m\]❯\[\e[0m\] "
}

# powerline — pastel segments with rounded ends; the clock at the right edge (the app draws
# it there, so it isn't text the bar could run into)
__agy_ps_powerline() {
  local clock= rclock=
  (( cols >= 30 )) && printf -v clock '%(%-I:%M %p)T' -1

  # segments: "r;g;b|icon text" — dark text on pastel backgrounds
  local dir_icon=$'\uf07b'
  [ "$PWD" = "$HOME" ] && dir_icon=$'\uf015'
  local -a segs=()
  segs+=("245;169;127|"$'\uf007'" ${USER:-root}")
  segs+=("243;139;168|${dir_icon} @PATH")
  [ -n "$__agy_b" ] && segs+=("249;226;175|"$'\ue0a0'" @BRANCH")
  (( status != 0 )) && segs+=("235;111;146|"$'\uf071'" ${status}")

  # Fit the phone's width (leaving room for the clock): the clock goes first, then the user's
  # segment, then the branch's; the path is shortened (the folder keeps its name, up to 12
  # cells; after that it's cut).
  local width i t room=$(( cols - 1 - (${#clock} ? ${#clock} + 6 : 0) ))
  __agy_width() {
    width=2
    for i in "${segs[@]}"; do t=${i#*|}; t=${t/@PATH/}; t=${t/@BRANCH/"$__agy_b"}; __agy_w "$t"; width=$(( width + __agy_n + 3 )); done
  }
  __agy_width
  if (( room - width < __agy_need )) && [ -n "$clock" ]; then clock=; room=$(( cols - 1 )); fi
  if (( room - width < __agy_need )); then segs=("${segs[@]:1}"); __agy_width; fi
  if (( room - width < __agy_need )) && [[ ${segs[1]} == *@BRANCH* ]]; then unset 'segs[1]'; segs=("${segs[@]}"); __agy_width; fi
  __agy_fit_path $(( room - width ))

  [ -n "$clock" ] && rclock="\[\e]7770;rprompt;${__agy_tok};${clock}\a\]"

  local fg='30;30;46' line= n=${#segs[@]} bg next
  for (( i = 0; i < n; i++ )); do
    bg=${segs[i]%%|*}
    (( i == 0 )) && line+="\[\e[0m\e[38;2;${bg}m\]"$'\ue0b6'
    t=${segs[i]#*|}; t=${t/@PATH/"$__agy_p"}; t=${t/@BRANCH/"$__agy_b"}
    __agy_txt[i]=$t
    line+="\[\e[48;2;${bg}m\e[38;2;${fg}m\] \${__agy_txt[$i]} "
    if (( i + 1 < n )); then
      next=${segs[i + 1]%%|*}
      line+="\[\e[48;2;${next}m\e[38;2;${bg}m\]"$'\ue0b0'
    else
      line+="\[\e[0m\e[38;2;${bg}m\]"$'\ue0b4'"\[\e[0m\]"
    fi
  done

  # window title (shown on the app's tab) + segments + input line
  PS1="${__agy_bar}${rclock}${title}${line}\n\[\e[38;2;${mark}m\]❯\[\e[0m\] "
}
# (first, to see the command's status; other tools' hooks set earlier keep running after it)
[[ ${PROMPT_COMMAND-} == *__agy_prompt* ]] || PROMPT_COMMAND="__agy_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
# a command starts (the app's "task finished" notification waits for the prompt again); its
# start time is noted for the prompt's "took 5s" (the empty slice prints nothing — the
# arithmetic sets the variable)
PS0=$'\e]7770;exec;'"${__agy_tok}"$'\a''${PS0:0:$((__agy_t0=SECONDS,0))}'

# ---------------------------------------------------------------- agents on demand
# Typing 'agy', 'claude', 'codex' or 'opencode' before they are installed installs them first.
command_not_found_handle() {
  case "$1" in
    # (installed for the real home — in an extra account's tab this runs with that account's
    # HOME; and once only: still missing after it, it says so instead of trying again forever)
    agy|claude|codex|opencode)
      env HOME="${ANTICODE_REAL_HOME:-$HOME}" -u XDG_CONFIG_HOME -u XDG_DATA_HOME -u XDG_STATE_HOME -u XDG_CACHE_HOME \
        /usr/local/bin/"$1"-setup --auto || return
      hash -r
      export PATH="${ANTICODE_REAL_HOME:-$HOME}/.local/bin:$PATH"
      type -P "$1" >/dev/null || { printf '%s: still not found after setup — try %s-setup\n' "$1" "$1" >&2; return 127; }
      command "$@"; return ;;
  esac
  if [ -x /usr/lib/command-not-found ]; then /usr/lib/command-not-found -- "$1"; return $?; fi
  printf '%s: command not found\n' "$1" >&2
  return 127
}
# Antigravity counts a Bangla conjunct (ক্ষ) as one character, as Unicode 15.1 does; the shell
# and other programs (Claude Code too) count its letters. The terminal draws it the program's
# way, so the program's tables and input line come out right (back to letters at the prompt).
# Settings → "Antigravity: approve everything": its own flag, when agy starts a session (not
# for a subcommand such as `agy plugin …`)
# A tab opened for one of an agent's extra accounts (ANTICODE_PROFILE): `agy` / `claude` typed
# in it sign in with that account too (see anticode-account).
agy() {
  # (to the app — on the terminal only: `agy -p … > out.md` gets agy's output, nothing else)
  [ -t 1 ] && printf '\e]7770;exec;%s;agy\a' "$__agy_tok"
  local -a pre=()
  if [ -f "$HOME/.config/agy-terminal/agy-approve-all" ] && { [ $# -eq 0 ] || [[ $1 == -* ]]; }; then
    pre=(--dangerously-skip-permissions)
  fi
  local h=
  [ -n "${ANTICODE_PROFILE-}" ] && h=$(/usr/local/bin/anticode-account agy 2>/dev/null)
  if [ -n "$h" ]; then
    ANTICODE_REAL_HOME=$HOME HOME=$h XDG_CONFIG_HOME=$h/.config XDG_DATA_HOME=$h/.local/share \
      XDG_STATE_HOME=$h/.local/state XDG_CACHE_HOME=$h/.cache command agy "${pre[@]}" "$@"
  else command agy "${pre[@]}" "$@"; fi
}
codex() {
  [ -t 1 ] && printf '\e]7770;exec;%s;codex\a' "$__agy_tok"
  local d=
  [ -n "${ANTICODE_PROFILE-}" ] && d=$(/usr/local/bin/anticode-account codex 2>/dev/null)
  /usr/local/bin/anticode-account codex-config "${d:-${CODEX_HOME:-$HOME/.codex}}"
  if [ -n "$d" ]; then CODEX_HOME=$d command codex "$@"; else command codex "$@"; fi
}
opencode() {
  # (OpenCode 1 put in by an earlier version of the app: OpenCode 2 first)
  local pkg=
  [ -r "$HOME/.local/share/opencode-cli/.package" ] && read -r pkg < "$HOME/.local/share/opencode-cli/.package"
  if [ -e "$HOME/.local/share/opencode-cli" ] && [ "$pkg" != @opencode/cli ]; then
    env HOME="${ANTICODE_REAL_HOME:-$HOME}" /usr/local/bin/opencode-setup --auto || return
  fi
  [ -t 1 ] && printf '\e]7770;exec;%s;opencode\a' "$__agy_tok"
  # bare `opencode`: the compact view (input at the bottom) unless Settings → "OpenCode:
  # full-screen view" is on
  [ $# -eq 0 ] && [ -t 1 ] && [ ! -f "$HOME/.config/agy-terminal/opencode-fullscreen" ] && set -- mini
  local d=
  [ -n "${ANTICODE_PROFILE-}" ] && d=$(/usr/local/bin/anticode-account opencode 2>/dev/null)
  if [ -n "$d" ]; then XDG_DATA_HOME=$d command opencode "$@"; else command opencode "$@"; fi
}
claude() {
  [ -t 1 ] && printf '\e]7770;exec;%s;claude\a' "$__agy_tok"
  local d=
  [ -n "${ANTICODE_PROFILE-}" ] && d=$(/usr/local/bin/anticode-account claude 2>/dev/null)
  if [ -n "$d" ]; then CLAUDE_CONFIG_DIR=$d command claude "$@"; else command claude "$@"; fi
}

# ---------------------------------------------------------------- ble.sh look & attach
if [[ ${BLE_VERSION-} ]]; then
  bleopt char_width_mode=west          # same widths as the app's renderer, no terminal probing
  # Typing stays quick under proot, where every file check and every program started is slow:
  # - grey suggestions come from the history only. The completion system behind the other
  #   kind runs programs (git, apt …) and lists every command in $PATH at each pause, and
  #   the keys typed meanwhile waited. (Tab still completes as before.)
  blehook/eval-after-load complete '_ble_complete_auto_source=(history)'
  # - the history search is cheap and gives way to the next key: the suggestion shows with
  #   the letter typed, not a moment later as a separate redraw
  bleopt complete_auto_delay=30
  # - no file checks for every word typed (a stat per word, per key; on /storage each is
  #   slow), and no second redraw when they ran late
  bleopt highlight_filename=
  bleopt highlight_timeout_sync=20 complete_timeout_auto=800 2>/dev/null
  bleopt complete_menu_style=align-nowrap
  bleopt edit_abell= edit_vbell=       # no beeps or flashes
  bleopt exec_errexit_mark=            # the prompt already shows a failed command's status
  bleopt exec_elapsed_mark=            # no "[ble: elapsed …]" lines
  # After a resize (zooming changes the width), redraw the prompt where it was. The
  # default guesses how the terminal re-wrapped it and gets it wrong for a two-line
  # prompt: every zoom left an extra blank line or a copy of the prompt bar behind.
  bleopt canvas_winch_action=redraw-prev
  bleopt prompt_eol_mark=$'\e[38;2;108;112;134m⏎\e[m'
  ble-face auto_complete='fg=#6c7086'
  # Calm colours. The command word is green as it's typed: with the file checks off it isn't
  # looked up (its colour would be ble.sh's "brown" — this theme's red, every command looking
  # wrong), and it doesn't flash red while half typed. A syntax error is soft red text.
  ble-face syntax_command='fg=#a6e3a1'
  ble-face command_builtin='fg=#a6e3a1' command_file='fg=#a6e3a1' command_function='fg=#cba6f7'
  ble-face command_alias='fg=#a6e3a1' command_keyword='fg=#89b4fa'
  ble-face syntax_quoted='fg=#f9e2af' syntax_comment='fg=#6c7086' syntax_error='fg=#eba0ac'
  ble-face region='bg=#45475a'
  # ⌫ removes a whole letter cluster — a letter with its vowel signs, a conjunct (ক্ষ) —
  # like Claude Code and the app's Bangla keyboard do (ble.sh itself removes one code point).
  function ble/widget/anticode-delete-backward-cluster {
    local s=$_ble_edit_str i=$_ble_edit_ind b ret c k
    ((i>0)) || { ble/widget/.bell; return 1; }
    ble/unicode/GraphemeCluster/find-previous-boundary "$s" "$i"; b=$ret
    # conjuncts: consonant + virama (+ ZWJ) + consonant stay together (Unicode GB9c) — the
    # same rule the app's keyboard counts with
    while ((b>=2)); do
      k=$((b-1))
      ble/util/s2c "${s:k:1}"
      if ((ret==0x200D)); then ((k>=1)) || break; ((k--)); ble/util/s2c "${s:k:1}"; fi
      ((ret==0x9CD||ret==0x94D)) || break
      ble/util/s2c "${s:b:1}"; c=$ret
      ((0x995<=c&&c<=0x9B9||c==0x9DC||c==0x9DD||c==0x9DF||c==0x9F0||c==0x9F1||0x915<=c&&c<=0x939||0x958<=c&&c<=0x95F||0x978<=c&&c<=0x97F)) || break
      ble/unicode/GraphemeCluster/find-previous-boundary "$s" "$b"; k=$ret
      # only a chain that starts with a consonant ("অ্যা" is অ্ + যা)
      ble/util/s2c "${s:k:1}"; c=$ret
      ((0x995<=c&&c<=0x9B9||c==0x9DC||c==0x9DD||c==0x9DF||c==0x9F0||c==0x9F1||0x915<=c&&c<=0x939||0x958<=c&&c<=0x95F||0x978<=c&&c<=0x97F)) || break
      b=$k
    done
    ((b<i)) || b=$((i-1))
    ble/widget/.delete-char "$((b-i))" || ble/widget/.bell
  }
  function anticode/ble-keys {
    ble-bind -m emacs -f 'DEL' 'delete-region-or anticode-delete-backward-cluster'
    ble-bind -m emacs -f 'C-?' 'delete-region-or anticode-delete-backward-cluster'
    ble-bind -m emacs -f 'C-h' 'delete-region-or anticode-delete-backward-cluster'
  }
  blehook/eval-after-load keymap_emacs anticode/ble-keys 2>/dev/null || anticode/ble-keys
  # (ble.sh runs commands itself: say when one starts from its hook as well — with the
  # command's name, so the app knows an agent started however the line was typed)
  function __agy_preexec {
    local w=${1#"${1%%[![:space:]]*}"}
    w=${w%%[[:space:]]*}
    w=${w//[[:cntrl:];]/}
    printf '\e]7770;exec;%s;%s\a' "$__agy_tok" "${w:0:40}"
    __agy_t0=$SECONDS
  }
  blehook PREEXEC+='__agy_preexec "$1"' 2>/dev/null
  ble-attach
fi
