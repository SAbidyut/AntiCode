#!/bin/bash
# Started by the app's "Copilot" button: install if needed, run copilot, then stay in a shell.
export PATH="$HOME/.local/bin:$PATH"
# Ctrl-C stops the agent (or its setup), not this script: the tab goes on to its shell
trap : INT
command -v copilot >/dev/null 2>&1 || /usr/local/bin/copilot-setup --auto
if command -v copilot >/dev/null 2>&1; then
  printf '\e]7770;exec;%s;copilot\a' "${ANTICODE_LINK_TOKEN:-}"
  # the tab's account: one of the extra ones keeps its config and sign-in apart (see anticode-account)
  acct_dir=$(/usr/local/bin/anticode-account copilot)
  if [ -n "$acct_dir" ]; then COPILOT_HOME=$acct_dir copilot; else copilot; fi
else
  echo "copilot was not found — run 'copilot-setup' and try again."
fi
exec bash -l
