#!/bin/bash
# Started by the app's "OpenCode" button: install if needed, run opencode, then stay in a shell.
export PATH="$HOME/.local/bin:$PATH"
# Ctrl-C stops the agent (or its setup), not this script: the tab goes on to its shell
trap : INT
# (not there yet, or OpenCode 1 from an earlier version of the app: OpenCode 2 is put in)
pkg=; [ -r "$HOME/.local/share/opencode-cli/.package" ] && read -r pkg < "$HOME/.local/share/opencode-cli/.package"
{ command -v opencode >/dev/null 2>&1 && [ "$pkg" = @opencode/cli ]; } || /usr/local/bin/opencode-setup --auto
if command -v opencode >/dev/null 2>&1; then
  printf '\e]7770;exec;%s;opencode\a' "${ANTICODE_LINK_TOKEN:-}"
  # the tab's account: one of the extra ones keeps its sign-ins apart (see anticode-account)
  acct_dir=$(/usr/local/bin/anticode-account opencode)
  if [ -n "$acct_dir" ]; then XDG_DATA_HOME=$acct_dir opencode; else opencode; fi
else
  echo "opencode was not found — run 'opencode-setup' and try again."
fi
exec bash -l
