#!/bin/bash
# Started by the app's "Claude Code" button: install if needed, run claude, then stay in a shell.
export PATH="$HOME/.local/bin:$PATH"
command -v claude >/dev/null 2>&1 || /usr/local/bin/claude-setup --auto
if command -v claude >/dev/null 2>&1; then
  printf '\e]7770;exec;claude\a'   # (the app shows the signed-in account by its header)
  claude
else
  echo "claude was not found — run 'claude-setup' and try again."
fi
exec bash -l
