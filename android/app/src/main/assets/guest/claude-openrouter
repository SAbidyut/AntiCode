#!/bin/bash
# AntiCode: Claude Code with OpenRouter models.
#   claude-openrouter [claude arguments…]
# Claude Code talks to a small local server (openrouter-proxy.py) that adds your OpenRouter API
# key (saved by `openrouter-key`) and lists OpenRouter's models for Claude Code's /model picker.
# Opus / Sonnet / Haiku mean OpenRouter's newest Claude models; /model offers all the others
# (ids with "anthropic/" in front, which Claude Code needs to list them). Put model ids in
# ~/.config/agy-terminal/openrouter-models (one a line) to have them listed first. The server
# lives as long as this Claude Code does. Claude Code is made for Claude models: others may
# work less well (they need to be able to call tools).
export PATH="$HOME/.local/bin:$PATH"
G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; N='\033[0m'
keyfile="$HOME/.config/agy-terminal/openrouter-api-key"
proxy=/usr/local/bin/openrouter-proxy.py

# 1. a key
if ! grep -qs '[^[:space:]]' "$keyfile"; then
  echo -e "${Y}Claude Code with OpenRouter needs an OpenRouter API key (openrouter.ai/keys).${N}"
  /usr/local/bin/openrouter-key set || exit 1
fi
# 2. Claude Code itself, and Python for the local server
command -v claude >/dev/null 2>&1 || /usr/local/bin/claude-setup --auto || exit 1
if ! command -v python3 >/dev/null 2>&1; then
  echo -e "${G}▸ Installing Python (for the OpenRouter helper, ~25 MB, once)${N}"
  /usr/local/bin/term-setup --auto
  DEBIAN_FRONTEND=noninteractive apt-get update >/dev/null 2>&1
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 \
    || { echo -e "${R}Installing Python failed — check the connection and run claude-openrouter again.${N}"; exit 1; }
fi

# 3. the local server: its own secret token (no other app on the phone can use your key through
#    it), a free port of its own, gone when Claude Code ends
tok=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
work=$(mktemp -d /tmp/openrouter-proxy.XXXXXX) || exit 1
OPENROUTER_PROXY_TOKEN=$tok OPENROUTER_KEY_FILE=$keyfile python3 "$proxy" --port-file "$work/port" 2>"$work/log" &
pid=$!
cleanup() { kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; rm -rf "$work"; }
trap cleanup EXIT
trap : INT   # Ctrl-C stops Claude Code's work, not this launcher
for _ in $(seq 1 100); do [ -s "$work/port" ] && break; kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
if [ ! -s "$work/port" ]; then
  echo -e "${R}The OpenRouter helper did not start:${N}"; cat "$work/log" 2>/dev/null; exit 1
fi

# 4. Claude Code, pointed at it
export ANTHROPIC_BASE_URL="http://127.0.0.1:$(cat "$work/port")"
export ANTHROPIC_AUTH_TOKEN=$tok
export ANTHROPIC_API_KEY=""   # (OpenRouter's guide: must be explicitly empty)
unset ANTHROPIC_MODEL
# a Claude Code folder of its own: its theme and history stay apart from the Claude account's
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude-openrouter}"
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
# OpenRouter's "newest of that family" names
export ANTHROPIC_DEFAULT_OPUS_MODEL="~anthropic/claude-opus-latest"
export ANTHROPIC_DEFAULT_SONNET_MODEL="~anthropic/claude-sonnet-latest"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="~anthropic/claude-haiku-latest"
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   # (a flag of Anthropic's own that other models may refuse)
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 # (no calls to Anthropic from this mode)
# (the local call must not go through a web proxy)
export NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}"
claude "$@"
